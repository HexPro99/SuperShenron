<Window x:Class="Unverum.ShenronWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shenron" Icon="../Assets/SuperShenron.ico"
        Background="#202020" Width="560" Height="640" MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,2"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="#a8a8a8"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Background" Value="#494949"/>
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,18">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="../Assets/Shenron.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Shenron" Foreground="#f2f2f2" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Muted}" Text="DBFZ: KAI by HexPro99. Online input delay, ring links and practice tools for Dragon Ball FighterZ."/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Name="DelayCard">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Frame delay"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Input delay for online matches, in frames (1 frame is about 16.7 ms). It only changes your side, your opponent doesn't need Shenron."/>
                    <RadioButton Name="ModeOff" GroupName="DelayMode" Checked="Mode_Changed" Foreground="#f2f2f2" FontSize="14" Margin="0,2">
                        <TextBlock Style="{StaticResource Body}" Text="Off, use the game's own delay"/>
                    </RadioButton>
                    <RadioButton Name="ModeAuto" GroupName="DelayMode" Checked="Mode_Changed" Foreground="#f2f2f2" FontSize="14" Margin="0,2">
                        <TextBlock Style="{StaticResource Body}" Text="Auto, Shenron picks it from your ping at the start of each match"/>
                    </RadioButton>
                    <RadioButton Name="ModeManual" GroupName="DelayMode" Checked="Mode_Changed" Foreground="#f2f2f2" FontSize="14" Margin="0,2">
                        <TextBlock Style="{StaticResource Body}" Text="Manual, always the same number of frames"/>
                    </RadioButton>
                    <Grid Margin="22,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="DelaySlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                ValueChanged="DelaySlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Name="DelayValueText" Grid.Column="1" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="14,0,0,0" MinWidth="70" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Name="ApplyButton" Style="{StaticResource PanelButton}" Content="Apply" Click="Apply_Click"/>
                        <TextBlock Name="AppliedText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Name="DelayFileText" Style="{StaticResource Muted}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Changes apply from your next online match, a match that's already running keeps its delay."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Last match"/>
                    <TextBlock Name="LastMatchText" Style="{StaticResource Body}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="UseRecommendedButton" Style="{StaticResource PanelButton}" Content="Use recommended" MinWidth="150" Click="UseRecommended_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Status"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Muted}" Text="Installed" Margin="0,2"/>
                        <TextBlock Name="InstalledText" Grid.Column="1" Style="{StaticResource Body}" Margin="0,2"/>
                        <TextBlock Style="{StaticResource Muted}" Grid.Row="1" Text="Latest release" Margin="0,2"/>
                        <TextBlock Name="LatestText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Margin="0,2"/>
                    </Grid>
                    <TextBlock Name="StatusNote" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Name="CheckButton" Style="{StaticResource PanelButton}" Content="Check for update" MinWidth="140" Click="Check_Click" Margin="0,0,10,6"/>
                        <Button Name="ReinstallButton" Style="{StaticResource PanelButton}" Content="Reinstall" Click="Reinstall_Click" Margin="0,0,10,6"/>
                        <Button Name="OpenFolderButton" Style="{StaticResource PanelButton}" Content="Open folder" Click="OpenFolder_Click" Margin="0,0,10,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Hotkeys"/>
                    <TextBlock Style="{StaticResource SubHeading}" Text="Training"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="F3" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" Text="Save State" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Body}" FontWeight="SemiBold" Text="F4" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="Load State" Margin="0,3"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" Text="* Can be remapped in the game's button config settings."/>
                    <TextBlock Style="{StaticResource SubHeading}" Text="Replays"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Select + Up" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" Text="Save State" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Select + Down" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="Load State" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Select + Left" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" Text="Takeover P1. Press again to end Takeover" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Select + Right" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Body}" Text="Takeover P2. Press again to end Takeover" Margin="0,3"/>
                    </Grid>
                    <TextBlock Style="{StaticResource SubHeading}" Text="Ring Matches"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="F1 (in a ring)" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" Text="Copy the invite link of the ring you're in" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Ctrl + F1" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="Add invite link to next Ring Match Search" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Ctrl + F2" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" Text="Stop adding invite link to next Ring Match Search" Margin="0,3"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Utilities"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="CrashLogButton" Style="{StaticResource PanelButton}" Content="Open crash log" MinWidth="140" Click="CrashLog_Click"/>
                        <TextBlock Name="CrashLogText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PanelButton}" Content="Close" HorizontalAlignment="Right" Margin="0" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
