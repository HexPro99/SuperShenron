<Window x:Class="Unverum.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SUPER SHENRON" Icon="../Assets/SuperShenron.ico"
        Background="#202020" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="26,22,26,22">
        <Image Source="../Assets/Shenron.png" Width="150" Height="150" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="SUPER SHENRON" Foreground="#f2f2f2" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Name="VersionText" Foreground="#a8a8a8" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,16"/>
        <TextBlock Foreground="#f2f2f2" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                   Text="A mod manager for Dragon Ball FighterZ that installs Shenron (DBFZ: KAI) and keeps it up to date."/>
        <TextBlock Foreground="#f2f2f2" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                   Text="Built on Unverum Mod Manager by TekkaGB, which is open source under the GNU GPL v3. Thank you TekkaGB and everyone who worked on Unverum."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Content="Unverum on GitHub" Height="30" Padding="14,0" Margin="0,0,10,0" Background="#494949" Foreground="#f2f2f2" Tag="https://github.com/TekkaGB/Unverum" Click="Link_Click"/>
            <Button Content="Shenron releases" Height="30" Padding="14,0" Margin="0,0,10,0" Background="#494949" Foreground="#f2f2f2" Tag="https://github.com/HexPro99/DBFZKAI/releases" Click="Link_Click"/>
            <Button Content="DBFZ on GameBanana" Height="30" Padding="14,0" Background="#494949" Foreground="#f2f2f2" Tag="https://gamebanana.com/games/6246" Click="Link_Click"/>
        </StackPanel>
        <Button Content="Close" Height="30" Width="110" Margin="0,22,0,0" HorizontalAlignment="Center" Background="#494949" Foreground="#f2f2f2" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
